# Шаблон настроек. Скопируйте в .env и замените заглушки:  cp .env.example .env
# Файл .env НЕЛЬЗЯ коммитить в git — он уже в .gitignore.
# Здесь только заглушки, настоящих секретов быть не должно.

# --- Для docker-compose (локальная база) ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# --- Для приложения и Prisma ---
# Логин, пароль, порт и имя базы здесь должны совпадать со значениями выше.
# Если в пароле есть спецсимволы (@ : / # ?), закодируйте их (например, @ -> %40)
# или используйте пароль только из букв и цифр.
DATABASE_URL="postgresql://app_user:change_me_to_a_long_random_password@localhost:5432/app_db?schema=public"

# --- Пароли тестовых пользователей (только для демо, не использовать нигде ещё) ---
SEED_ALPHA_PASSWORD=demo-only-alpha-change-me
SEED_BETA_PASSWORD=demo-only-beta-change-me

# --- Сессия пользователя ---
SESSION_TTL_MINUTES=60
