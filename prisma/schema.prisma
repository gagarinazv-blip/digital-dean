// Схема данных — описание таблиц вашей базы.
// После любого изменения этого файла выполните: npm run db:migrate -- --name <описание>

generator client {
  provider = "prisma-client"
  // Сюда Prisma сгенерирует типизированный клиент (папка не коммитится в git)
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Адрес базы (DATABASE_URL) задаётся в prisma.config.ts, а не здесь
}

enum UserRole {
  STUDENT
  STAFF
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleKind {
  LECTURE
  SEMINAR
  PRACTICE
}

enum ScheduleStatus {
  PLANNED
  RESCHEDULED
  CANCELLED
}

enum ControlType {
  EXAM
  CREDIT
  DIFFERENTIATED_CREDIT
  COURSEWORK
  OTHER
}

enum RequestType {
  CERTIFICATE
  APPLICATION
  OTHER
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  NEEDS_INFO
  READY
  REJECTED
}

enum RequestCommentVisibility {
  PUBLIC
  INTERNAL
}

model User {
  id              Int              @id @default(autoincrement())
  login           String           @unique
  passwordHash    String
  role            UserRole         @default(STUDENT)
  student         Student?
  staffProfile    StaffProfile?
  sessions        Session[]
  requestComments RequestComment[] @relation("RequestCommentAuthor")
  createdAt       DateTime         @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  keyHash         String   @id
  windowStartedAt DateTime @default(now())
  attempts        Int      @default(0)

  @@index([windowStartedAt])
}

model Student {
  id            Int            @id @default(autoincrement())
  userId        Int            @unique
  fullName      String
  faculty       String
  direction     String
  course        Int
  groupId       Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  group         StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  grades        Grade[]
  requests      Request[]
  notifications Notification[]

  @@index([groupId])
}

model StaffProfile {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  fullName         String
  position         String
  department       String
  isSupervisor     Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRequests Request[] @relation("AssignedStaffRequests")
}

model StudentGroup {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  students      Student[]
  scheduleItems ScheduleItem[]
  notifications Notification[]
}

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  teacher       String
  scheduleItems ScheduleItem[]
  grades        Grade[]
}

model ScheduleItem {
  id               Int            @id @default(autoincrement())
  subjectId        Int
  groupId          Int
  weekday          Weekday?
  date             DateTime?      @db.Date
  startTime        DateTime       @db.Time(0)
  endTime          DateTime       @db.Time(0)
  startsAt         DateTime?      @db.Timestamptz(3)
  endsAt           DateTime?      @db.Timestamptz(3)
  originalStartsAt DateTime?      @db.Timestamptz(3)
  originalEndsAt   DateTime?      @db.Timestamptz(3)
  originalRoom     String?
  kind             ScheduleKind   @default(LECTURE)
  status           ScheduleStatus @default(PLANNED)
  room             String         @map("classroom")
  teacher          String
  changeNote       String?        @map("comment")
  isRescheduled    Boolean        @default(false)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  group            StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([subjectId])
  @@index([groupId, startsAt])
  @@index([date])
  @@index([weekday])
}

model Grade {
  id          Int         @id @default(autoincrement())
  studentId   Int
  subjectId   Int
  semester    String
  controlType ControlType
  value       String
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())

  @@index([studentId])
  @@index([subjectId])
}

model Request {
  id           Int              @id @default(autoincrement())
  studentId    Int
  type         RequestType
  status       RequestStatus    @default(NEW)
  comment      String?
  assignedToId Int?
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assignedTo   StaffProfile?    @relation("AssignedStaffRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments     RequestComment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([assignedToId])
}

model RequestComment {
  id           Int                      @id @default(autoincrement())
  requestId    Int
  authorUserId Int
  visibility   RequestCommentVisibility @default(PUBLIC)
  content      String                   @db.Text
  request      Request                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User                     @relation("RequestCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  attachments  RequestAttachment[]
  createdAt    DateTime                 @default(now())

  @@index([requestId, createdAt])
  @@index([authorUserId])
}

model RequestAttachment {
  id        Int            @id @default(autoincrement())
  commentId Int
  fileName  String
  mediaType String
  sizeBytes Int
  data      Bytes
  comment   RequestComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([commentId])
}

model Notification {
  id        Int           @id @default(autoincrement())
  title     String
  text      String
  date      DateTime      @default(now())
  deadline  DateTime?
  isRead    Boolean       @default(false)
  studentId Int?
  groupId   Int?
  student   Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  group     StudentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([groupId])
  @@index([date])
  @@index([deadline])
}
