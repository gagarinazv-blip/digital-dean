// Схема данных — описание таблиц вашей базы.
// После любого изменения этого файла выполните: npm run db:migrate -- --name <описание>

generator client {
  provider = "prisma-client"
  // Сюда Prisma сгенерирует типизированный клиент (папка не коммитится в git)
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Адрес базы (DATABASE_URL) задаётся в prisma.config.ts, а не здесь
}

enum UserRole {
  STUDENT
  STAFF
}

enum StudentAccountStatus {
  INVITED
  ACTIVE
}

enum StudentAuditAction {
  STUDENT_CREATED
  PROFILE_UPDATED
  PHONE_CHANGED
  CORPORATE_EMAIL_CHANGED
  CORPORATE_MAIL_PASSWORD_SET
  CORPORATE_MAIL_PASSWORD_REPLACED
  CORPORATE_MAIL_PASSWORD_CLEARED
  STUDENT_PASSWORD_SET
  STUDENT_PASSWORD_REPLACED
  ACCESS_RESET
  PORTFOLIO_ITEM_CREATED
  PORTFOLIO_ITEM_UPDATED
  PORTFOLIO_ITEM_DELETED
  PORTFOLIO_FILE_DOWNLOADED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleKind {
  LECTURE
  SEMINAR
  PRACTICE
}

enum ScheduleStatus {
  PLANNED
  RESCHEDULED
  CANCELLED
}

enum ControlType {
  EXAM
  CREDIT
  DIFFERENTIATED_CREDIT
  COURSEWORK
  OTHER
}

enum StudyForm {
  FULL_TIME
  PART_TIME
  CORRESPONDENCE
}

enum AcademicResultStatus {
  PASSED
  ACADEMIC_DEBT
}

enum AcademicSessionStatus {
  COMPLETED
  PLANNED
  RESCHEDULED
  CANCELLED
}

enum RequestType {
  CERTIFICATE
  APPLICATION
  OTHER
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  NEEDS_INFO
  READY
  REJECTED
  CANCELLED
}

enum RequestCommentVisibility {
  PUBLIC
  INTERNAL
}

enum RequestAttachmentKind {
  REQUEST
  RESULT
}

enum NotificationType {
  SCHEDULE_CHANGE
  DEADLINE
  REQUEST_STATUS
  ANNOUNCEMENT
  OPPORTUNITY_STATUS
}

enum NotificationTargetType {
  SCHEDULE_ITEM
  DEADLINE
  REQUEST
  ACADEMIC_SESSION
  OPPORTUNITY_APPLICATION
}

enum DeadlineStatus {
  OPEN
  SUBMITTED
}

enum PortfolioCategory {
  VOLUNTEERING
  SCIENCE
  COMPETITION
  SPORT
  CREATIVITY
  OTHER
}

enum PortfolioSource {
  STUDENT
  STAFF
}

enum StaffNotificationType {
  NEW_REQUEST
  DOCUMENT_ADDED
  REQUEST_ASSIGNED
  REQUEST_REASSIGNED
  NEW_OPPORTUNITY_APPLICATION
}

enum EventType {
  CONFERENCE
  SPEAKER_MEETING
  MASTER_CLASS
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum OpportunityType {
  COMPETITION
  INTERNSHIP
  CONFERENCE
  OTHER
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OpportunityApplicationStatus {
  SUBMITTED
  IN_REVIEW
  NEEDS_INFO
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum StudentDocumentType {
  PASSPORT
  SNILS
  INSURANCE
  CONTRACT
  OTHER
}

model User {
  id                       Int                        @id @default(autoincrement())
  login                    String                     @unique
  passwordHash             String?
  role                     UserRole                   @default(STUDENT)
  student                  Student?
  staffProfile             StaffProfile?
  sessions                 Session[]
  requestComments          RequestComment[]           @relation("RequestCommentAuthor")
  requestStatusHistory     RequestStatusHistory[]     @relation("RequestStatusHistoryAuthor")
  requestAssignmentHistory RequestAssignmentHistory[] @relation("RequestAssignmentHistoryAuthor")
  studentAuditLogs         StudentAuditLog[]
  uploadedPortfolioItems   PortfolioItem[]             @relation("PortfolioItemUploader")
  staffNotifications       StaffNotification[]         @relation("StaffNotificationRecipient")
  createdEvents            Event[]                    @relation("EventCreator")
  createdOpportunities     Opportunity[]               @relation("OpportunityCreator")
  decidedApplications      OpportunityApplication[]    @relation("ApplicationDecider")
  createdAt                DateTime                   @default(now())
}

model Session {
  id                    String   @id @default(cuid())
  tokenHash             String   @unique
  userId                Int
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requiresPasswordSetup Boolean  @default(false)
  createdAt             DateTime @default(now())
  expiresAt             DateTime

  @@index([userId])
  @@index([expiresAt])
}

model LoginCode {
  id        Int       @id @default(autoincrement())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ip        String

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@index([expiresAt])
}

model LoginAttempt {
  keyHash         String   @id
  windowStartedAt DateTime @default(now())
  attempts        Int      @default(0)

  @@index([windowStartedAt])
}

model Student {
  id                             Int                  @id @default(autoincrement())
  userId                         Int                  @unique
  fullName                       String
  faculty                        String
  direction                      String
  course                         Int
  groupId                        Int
  phone                          String?              @unique
  accountStatus                  StudentAccountStatus @default(ACTIVE)
  corporateEmail                 String?              @unique
  corporateMailPasswordEncrypted String?
  corporateMailIssuedAt          DateTime?
  recordBookNumber               String?              @unique
  studyForm                      StudyForm?
  user                           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  group                          StudentGroup         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  grades                         Grade[]
  academicSemesters              AcademicSemester[]
  requests                       Request[]
  notifications                  Notification[]
  deadlines                      Deadline[]
  auditLogs                      StudentAuditLog[]
  portfolioFolders               PortfolioFolder[]
  portfolioItems                 PortfolioItem[]
  staffNotifications             StaffNotification[]
  studentDocuments               StudentDocument[]
  opportunityApplications        OpportunityApplication[]

  @@index([groupId])
}

model StaffProfile {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  fullName         String
  position         String
  department       String
  phone            String?   @unique
  isSupervisor     Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRequests Request[] @relation("AssignedStaffRequests")
  assignmentHistoryFrom RequestAssignmentHistory[] @relation("RequestAssignmentHistoryFrom")
  assignmentHistoryTo   RequestAssignmentHistory[] @relation("RequestAssignmentHistoryTo")
}

model Event {
  id              Int         @id @default(autoincrement())
  title           String      @db.VarChar(120)
  type            EventType
  description     String?     @db.VarChar(1000)
  startsAt        DateTime    @db.Timestamptz(3)
  endsAt          DateTime    @db.Timestamptz(3)
  location        String      @db.VarChar(160)
  host            String      @db.VarChar(160)
  registrationUrl String?     @db.VarChar(2048)
  status          EventStatus @default(DRAFT)
  createdById     Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       User        @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([startsAt, status])
  @@index([createdById])
}

model StudentGroup {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  students      Student[]
  scheduleItems ScheduleItem[]
  notifications Notification[]
}

model StudentAuditLog {
  id            Int                @id @default(autoincrement())
  studentId     Int
  actorUserId   Int?
  action        StudentAuditAction
  changedFields String[]           @default([])
  createdAt     DateTime           @default(now())
  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actor         User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([actorUserId, createdAt])
}

model PortfolioFolder {
  id        Int               @id @default(autoincrement())
  studentId Int
  parentId  Int?
  name      String            @db.VarChar(60)
  normalizedName String       @db.VarChar(60)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    PortfolioFolder?  @relation("PortfolioFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  PortfolioFolder[] @relation("PortfolioFolderTree")
  items     PortfolioItem[]

  @@unique([studentId, normalizedName])
  @@index([parentId])
}

model PortfolioItem {
  id           Int               @id @default(autoincrement())
  studentId    Int
  folderId     Int?
  title        String            @db.VarChar(120)
  category     PortfolioCategory @default(OTHER)
  eventName    String?           @db.VarChar(180)
  eventDate    DateTime?         @db.Date
  role         String?           @db.VarChar(100)
  description  String?           @db.VarChar(500)
  storedName   String            @unique @db.VarChar(100)
  originalName String            @db.VarChar(255)
  mimeType     String            @db.VarChar(100)
  size         Int
  source       PortfolioSource
  uploadedById Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  folder       PortfolioFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy   User              @relation("PortfolioItemUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([studentId, category, eventDate])
  @@index([folderId])
  @@index([source])
}

model StudentDocument {
  id           Int                @id @default(autoincrement())
  studentId    Int
  title        String             @db.VarChar(120)
  documentType StudentDocumentType @default(OTHER)
  storedName   String             @unique @db.VarChar(100)
  originalName String             @db.VarChar(255)
  mimeType     String             @db.VarChar(100)
  size         Int
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([studentId, documentType])
}

model Opportunity {
  id                Int                  @id @default(autoincrement())
  title             String               @db.VarChar(120)
  type              OpportunityType
  organizer         String               @db.VarChar(160)
  description       String               @db.Text
  requirements      String               @db.Text
  deadline          DateTime
  officialUrl       String?              @db.VarChar(2048)
  eventDate         DateTime?
  format            String?              @db.VarChar(100)
  requiredDocuments Json
  status            OpportunityStatus    @default(DRAFT)
  createdById       Int
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  createdBy         User                 @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  applications      OpportunityApplication[]

  @@index([status, deadline])
  @@index([createdById])
}

model OpportunityApplication {
  id            Int                        @id @default(autoincrement())
  publicId      String                     @unique @default(uuid())
  opportunityId Int
  studentId     Int
  status        OpportunityApplicationStatus @default(SUBMITTED)
  motivation    String?                    @db.VarChar(2000)
  studentSnapshot Json
  staffComment  String?                    @db.VarChar(2000)
  decidedById   Int?
  submittedAt   DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  opportunity   Opportunity                @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student       Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  decidedBy     User?                      @relation("ApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  files         ApplicationFile[]

  @@index([studentId, submittedAt])
  @@index([opportunityId, status])
}

model ApplicationFile {
  id           Int                   @id @default(autoincrement())
  applicationId Int
  requirementKey String              @db.VarChar(80)
  originalName String                @db.VarChar(255)
  storedName   String                @unique @db.VarChar(100)
  mimeType     String                @db.VarChar(100)
  size         Int
  application  OpportunityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  teacher       String
  scheduleItems ScheduleItem[]
  grades        Grade[]
}

model ScheduleItem {
  id               Int            @id @default(autoincrement())
  subjectId        Int
  groupId          Int
  weekday          Weekday?
  date             DateTime?      @db.Date
  startTime        DateTime       @db.Time(0)
  endTime          DateTime       @db.Time(0)
  startsAt         DateTime?      @db.Timestamptz(3)
  endsAt           DateTime?      @db.Timestamptz(3)
  originalStartsAt DateTime?      @db.Timestamptz(3)
  originalEndsAt   DateTime?      @db.Timestamptz(3)
  originalRoom     String?
  kind             ScheduleKind   @default(LECTURE)
  status           ScheduleStatus @default(PLANNED)
  room             String         @map("classroom")
  teacher          String
  changeNote       String?        @map("comment")
  isRescheduled    Boolean        @default(false)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  group            StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([subjectId])
  @@index([groupId, startsAt])
  @@index([date])
  @@index([weekday])
}

model Grade {
  id          Int         @id @default(autoincrement())
  studentId   Int
  subjectId   Int
  semester    String
  controlType ControlType
  value       String
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())

  @@index([studentId])
  @@index([subjectId])
}

model AcademicDataset {
  id           String             @id
  academicYear String
  snapshotDate DateTime           @db.Date
  semesters    AcademicSemester[]
}

model AcademicSemester {
  id        Int                @id @default(autoincrement())
  datasetId String
  studentId Int
  code      String
  number    Int
  name      String
  isCurrent Boolean            @default(false)
  dataset   AcademicDataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planItems AcademicPlanItem[]

  @@unique([datasetId, studentId, code])
  @@index([studentId, isCurrent])
}

model AcademicPlanItem {
  id          String                @id
  semesterId  Int
  name        String
  department  String
  teacher     String
  hours       Int
  credits     Int
  controlType ControlType
  semester    AcademicSemester      @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  result      AcademicResult?
  sessions    AcademicSessionItem[]

  @@index([semesterId])
}

model AcademicResult {
  id           Int                  @id @default(autoincrement())
  planItemId   String               @unique
  status       AcademicResultStatus
  value        String
  date         DateTime             @db.Date
  attemptCount Int
  planItem     AcademicPlanItem     @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  attempts     AcademicAttempt[]
}

model AcademicAttempt {
  id            Int            @id @default(autoincrement())
  resultId      Int
  attemptNumber Int
  date          DateTime       @db.Date
  value         String
  result        AcademicResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, attemptNumber])
  @@index([date])
}

model AcademicSessionItem {
  id         Int                   @id @default(autoincrement())
  planItemId String
  date       DateTime              @db.Date
  startTime  DateTime              @db.Time(0)
  endTime    DateTime              @db.Time(0)
  room       String
  status     AcademicSessionStatus
  planItem   AcademicPlanItem      @relation(fields: [planItemId], references: [id], onDelete: Cascade)

  @@index([planItemId, date])
  @@index([date, startTime])
}

model Request {
  id              Int                    @id @default(autoincrement())
  publicId        String                 @unique @default(uuid())
  studentId       Int
  type            RequestType
  catalogCode     String?
  formFields      Json?
  profileSnapshot Json?
  status          RequestStatus          @default(NEW)
  comment         String?
  assignedToId    Int?
  student         Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assignedTo      StaffProfile?          @relation("AssignedStaffRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments        RequestComment[]
  statusHistory   RequestStatusHistory[]
  assignmentHistory RequestAssignmentHistory[]
  staffNotifications StaffNotification[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([assignedToId])
}

model StaffNotification {
  id               Int                  @id @default(autoincrement())
  publicId         String               @unique @default(uuid())
  recipientId      Int
  eventKey         String
  type             StaffNotificationType
  title            String
  body             String               @db.Text
  link             String
  relatedRequestId Int?
  relatedStudentId Int?
  readAt           DateTime?
  createdAt        DateTime             @default(now())
  recipient        User                 @relation("StaffNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  relatedRequest   Request?             @relation(fields: [relatedRequestId], references: [id], onDelete: SetNull)
  relatedStudent   Student?             @relation(fields: [relatedStudentId], references: [id], onDelete: SetNull)

  @@unique([recipientId, eventKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
}

model RequestStatusHistory {
  id           Int           @id @default(autoincrement())
  requestId    Int
  fromStatus   RequestStatus?
  status       RequestStatus
  isRollback   Boolean       @default(false)
  changedAt    DateTime      @default(now())
  authorUserId Int?
  comment      String?       @db.Text
  request      Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User?         @relation("RequestStatusHistoryAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, changedAt])
  @@index([authorUserId])
}

model RequestAssignmentHistory {
  id               Int           @id @default(autoincrement())
  requestId        Int
  fromAssignedToId Int?
  toAssignedToId   Int?
  changedByUserId  Int?
  changedAt        DateTime      @default(now())
  request          Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromAssignedTo   StaffProfile? @relation("RequestAssignmentHistoryFrom", fields: [fromAssignedToId], references: [id], onDelete: SetNull)
  toAssignedTo     StaffProfile? @relation("RequestAssignmentHistoryTo", fields: [toAssignedToId], references: [id], onDelete: SetNull)
  changedBy        User?         @relation("RequestAssignmentHistoryAuthor", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([requestId, changedAt])
  @@index([changedByUserId])
}

model RequestComment {
  id           Int                      @id @default(autoincrement())
  requestId    Int
  authorUserId Int
  visibility   RequestCommentVisibility @default(PUBLIC)
  content      String                   @db.Text
  request      Request                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User                     @relation("RequestCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  attachments  RequestAttachment[]
  createdAt    DateTime                 @default(now())

  @@index([requestId, createdAt])
  @@index([authorUserId])
}

model RequestAttachment {
  id        Int                   @id @default(autoincrement())
  commentId Int
  kind      RequestAttachmentKind @default(REQUEST)
  fileName  String
  mediaType String
  sizeBytes Int
  data      Bytes
  comment   RequestComment        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())

  @@index([commentId])
}

model Notification {
  id         Int                     @id @default(autoincrement())
  publicId   String                  @unique @default(uuid())
  title      String
  text       String
  date       DateTime                @default(now())
  createdAt  DateTime                @default(now())
  deadline   DateTime?
  isRead     Boolean                 @default(false)
  readAt     DateTime?
  type       NotificationType?
  targetType NotificationTargetType?
  targetId   String?
  studentId  Int?
  groupId    Int?
  student    Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)
  group      StudentGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([groupId])
  @@index([date])
  @@index([deadline])
  @@index([studentId, type, readAt, createdAt])
}

model Deadline {
  id          String         @id @default(cuid())
  studentId   Int
  subject     String
  title       String
  dueAt       DateTime       @db.Timestamptz(3)
  status      DeadlineStatus @default(OPEN)
  description String?        @db.Text
  createdAt   DateTime       @default(now())
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status, dueAt])
}
