// Схема данных — описание таблиц вашей базы.
// После любого изменения этого файла выполните: npm run db:migrate -- --name <описание>

generator client {
  provider = "prisma-client"
  // Сюда Prisma сгенерирует типизированный клиент (папка не коммитится в git)
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Адрес базы (DATABASE_URL) задаётся в prisma.config.ts, а не здесь
}

enum UserRole {
  STUDENT
  STAFF
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ScheduleKind {
  LECTURE
  SEMINAR
  PRACTICE
}

enum ScheduleStatus {
  PLANNED
  RESCHEDULED
  CANCELLED
}

enum ControlType {
  EXAM
  CREDIT
  DIFFERENTIATED_CREDIT
  COURSEWORK
  OTHER
}

enum StudyForm {
  FULL_TIME
  PART_TIME
  CORRESPONDENCE
}

enum AcademicResultStatus {
  PASSED
  ACADEMIC_DEBT
}

enum AcademicSessionStatus {
  COMPLETED
  PLANNED
}

enum RequestType {
  CERTIFICATE
  APPLICATION
  OTHER
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  NEEDS_INFO
  READY
  REJECTED
  CANCELLED
}

enum RequestCommentVisibility {
  PUBLIC
  INTERNAL
}

enum RequestAttachmentKind {
  REQUEST
  RESULT
}

enum NotificationType {
  SCHEDULE_CHANGE
  DEADLINE
  REQUEST_STATUS
}

enum NotificationTargetType {
  SCHEDULE_ITEM
  DEADLINE
  REQUEST
}

enum DeadlineStatus {
  OPEN
  SUBMITTED
}

model User {
  id                   Int                    @id @default(autoincrement())
  login                String                 @unique
  passwordHash         String
  role                 UserRole               @default(STUDENT)
  student              Student?
  staffProfile         StaffProfile?
  sessions             Session[]
  requestComments      RequestComment[]       @relation("RequestCommentAuthor")
  requestStatusHistory RequestStatusHistory[] @relation("RequestStatusHistoryAuthor")
  createdAt            DateTime               @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  keyHash         String   @id
  windowStartedAt DateTime @default(now())
  attempts        Int      @default(0)

  @@index([windowStartedAt])
}

model Student {
  id                Int                @id @default(autoincrement())
  userId            Int                @unique
  fullName          String
  faculty           String
  direction         String
  course            Int
  groupId           Int
  recordBookNumber  String?            @unique
  studyForm         StudyForm?
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  group             StudentGroup       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  grades            Grade[]
  academicSemesters AcademicSemester[]
  requests          Request[]
  notifications     Notification[]
  deadlines         Deadline[]

  @@index([groupId])
}

model StaffProfile {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  fullName         String
  position         String
  department       String
  isSupervisor     Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRequests Request[] @relation("AssignedStaffRequests")
}

model StudentGroup {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  students      Student[]
  scheduleItems ScheduleItem[]
  notifications Notification[]
}

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  teacher       String
  scheduleItems ScheduleItem[]
  grades        Grade[]
}

model ScheduleItem {
  id               Int            @id @default(autoincrement())
  subjectId        Int
  groupId          Int
  weekday          Weekday?
  date             DateTime?      @db.Date
  startTime        DateTime       @db.Time(0)
  endTime          DateTime       @db.Time(0)
  startsAt         DateTime?      @db.Timestamptz(3)
  endsAt           DateTime?      @db.Timestamptz(3)
  originalStartsAt DateTime?      @db.Timestamptz(3)
  originalEndsAt   DateTime?      @db.Timestamptz(3)
  originalRoom     String?
  kind             ScheduleKind   @default(LECTURE)
  status           ScheduleStatus @default(PLANNED)
  room             String         @map("classroom")
  teacher          String
  changeNote       String?        @map("comment")
  isRescheduled    Boolean        @default(false)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  group            StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([subjectId])
  @@index([groupId, startsAt])
  @@index([date])
  @@index([weekday])
}

model Grade {
  id          Int         @id @default(autoincrement())
  studentId   Int
  subjectId   Int
  semester    String
  controlType ControlType
  value       String
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now())

  @@index([studentId])
  @@index([subjectId])
}

model AcademicDataset {
  id           String             @id
  academicYear String
  snapshotDate DateTime           @db.Date
  semesters    AcademicSemester[]
}

model AcademicSemester {
  id        Int                @id @default(autoincrement())
  datasetId String
  studentId Int
  code      String
  number    Int
  name      String
  isCurrent Boolean            @default(false)
  dataset   AcademicDataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planItems AcademicPlanItem[]

  @@unique([datasetId, studentId, code])
  @@index([studentId, isCurrent])
}

model AcademicPlanItem {
  id          String                @id
  semesterId  Int
  name        String
  department  String
  teacher     String
  hours       Int
  credits     Int
  controlType ControlType
  semester    AcademicSemester      @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  result      AcademicResult?
  sessions    AcademicSessionItem[]

  @@index([semesterId])
}

model AcademicResult {
  id           Int                  @id @default(autoincrement())
  planItemId   String               @unique
  status       AcademicResultStatus
  value        String
  date         DateTime             @db.Date
  attemptCount Int
  planItem     AcademicPlanItem     @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  attempts     AcademicAttempt[]
}

model AcademicAttempt {
  id            Int            @id @default(autoincrement())
  resultId      Int
  attemptNumber Int
  date          DateTime       @db.Date
  value         String
  result        AcademicResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, attemptNumber])
  @@index([date])
}

model AcademicSessionItem {
  id         Int                   @id @default(autoincrement())
  planItemId String
  date       DateTime              @db.Date
  startTime  DateTime              @db.Time(0)
  endTime    DateTime              @db.Time(0)
  room       String
  status     AcademicSessionStatus
  planItem   AcademicPlanItem      @relation(fields: [planItemId], references: [id], onDelete: Cascade)

  @@index([planItemId, date])
  @@index([date, startTime])
}

model Request {
  id              Int                    @id @default(autoincrement())
  publicId        String                 @unique @default(uuid())
  studentId       Int
  type            RequestType
  catalogCode     String?
  formFields      Json?
  profileSnapshot Json?
  status          RequestStatus          @default(NEW)
  comment         String?
  assignedToId    Int?
  student         Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  assignedTo      StaffProfile?          @relation("AssignedStaffRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments        RequestComment[]
  statusHistory   RequestStatusHistory[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([assignedToId])
}

model RequestStatusHistory {
  id           Int           @id @default(autoincrement())
  requestId    Int
  status       RequestStatus
  changedAt    DateTime      @default(now())
  authorUserId Int?
  comment      String?       @db.Text
  request      Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User?         @relation("RequestStatusHistoryAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, changedAt])
  @@index([authorUserId])
}

model RequestComment {
  id           Int                      @id @default(autoincrement())
  requestId    Int
  authorUserId Int
  visibility   RequestCommentVisibility @default(PUBLIC)
  content      String                   @db.Text
  request      Request                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author       User                     @relation("RequestCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  attachments  RequestAttachment[]
  createdAt    DateTime                 @default(now())

  @@index([requestId, createdAt])
  @@index([authorUserId])
}

model RequestAttachment {
  id        Int                   @id @default(autoincrement())
  commentId Int
  kind      RequestAttachmentKind @default(REQUEST)
  fileName  String
  mediaType String
  sizeBytes Int
  data      Bytes
  comment   RequestComment        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime              @default(now())

  @@index([commentId])
}

model Notification {
  id         Int                     @id @default(autoincrement())
  publicId   String                  @unique @default(uuid())
  title      String
  text       String
  date       DateTime                @default(now())
  createdAt  DateTime                @default(now())
  deadline   DateTime?
  isRead     Boolean                 @default(false)
  readAt     DateTime?
  type       NotificationType?
  targetType NotificationTargetType?
  targetId   String?
  studentId  Int?
  groupId    Int?
  student    Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)
  group      StudentGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([groupId])
  @@index([date])
  @@index([deadline])
  @@index([studentId, type, readAt, createdAt])
}

model Deadline {
  id          String         @id @default(cuid())
  studentId   Int
  subject     String
  title       String
  dueAt       DateTime       @db.Timestamptz(3)
  status      DeadlineStatus @default(OPEN)
  description String?        @db.Text
  createdAt   DateTime       @default(now())
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status, dueAt])
}
